<layout>
    <adminhtml_contactforms_form_index>
        <reference name="menu">
            <action method="setActive">
                <menupath>cms/plugincompany_contactforms/form</menupath>
            </action>
        </reference>
        <reference name="content">
            <block type="plugincompany_contactforms/adminhtml_form" name="form" />

        </reference>
    </adminhtml_contactforms_form_index>
    <adminhtml_contactforms_form_grid>
        <block type="core/text_list" name="root" output="toHtml">
            <block type="plugincompany_contactforms/adminhtml_form_grid" name="form_grid"/>
        </block>
    </adminhtml_contactforms_form_grid>
    <!-- Form add/edit action -->
    <adminhtml_contactforms_form_edit>
        <update handle="editor"/>
        <reference name="head">
            <action method="addJs">
                <name>plugincompany/jquerynoconflict.js</name>
            </action>
            <action method="addJs">
                <name>plugincompany/contactforms/saveform.js</name>
            </action>
            <action method="addItem">
                <type>js_css</type>
                <name>plugincompany/contactforms/bfb/edit.css</name>
            </action>
            <action method="addJs">
                <name>plugincompany/codemirror/codemirror-compressed.js</name>
            </action>
            <action method="addItem">
                <type>js_css</type>
                <name>plugincompany/codemirror/codemirror.css</name>
            </action>
            <action method="addItem">
                <type>js_css</type>
                <name>plugincompany/contactforms/css/admin/codemirror.css</name>
            </action>
        </reference>
        <reference name="menu">
            <action method="setActive">
                <menupath>cms/plugincompany_contactforms/form</menupath>
            </action>
        </reference>
        <reference name="content">
            <block type="plugincompany_contactforms/adminhtml_form_edit" name="form_edit"></block>
        </reference>
        <reference name="left">
            <block type="plugincompany_contactforms/adminhtml_form_edit_tabs" name="form_tabs"></block>
        </reference>
    </adminhtml_contactforms_form_edit>
    <adminhtml_widget_instance_edit>
        <reference name="head">
            <action method="addJs">
                <name>plugincompany/lib/jscolor/jscolor.js</name>
            </action>
        </reference>
    </adminhtml_widget_instance_edit>

    <adminhtml_contactforms_entry_index>
        <reference name="menu">
            <action method="setActive">
                <menupath>cms/plugincompany_contactforms/entry</menupath>
            </action>
        </reference>
        <reference name="content">
            <block type="plugincompany_contactforms/adminhtml_entry" name="entry" />

        </reference>
    </adminhtml_contactforms_entry_index>
    <adminhtml_contactforms_entry_grid>
        <block type="core/text_list" name="root" output="toHtml">
            <block type="plugincompany_contactforms/adminhtml_entry_grid" name="entry_grid"/>
        </block>
    </adminhtml_contactforms_entry_grid>
    <!-- Entry add/edit action -->
    <adminhtml_contactforms_entry_edit>
        <update handle="editor"/>
        <reference name="menu">
            <action method="setActive">
                <menupath>cms/plugincompany_contactforms/entry</menupath>
            </action>
        </reference>
        <reference name="content">
            <block type="plugincompany_contactforms/adminhtml_entry_edit" name="entry_edit"></block>
        </reference>
        <reference name="left">
            <block type="plugincompany_contactforms/adminhtml_entry_edit_tabs" name="entry_tabs"></block>
        </reference>
    </adminhtml_contactforms_entry_edit>

</layout>
