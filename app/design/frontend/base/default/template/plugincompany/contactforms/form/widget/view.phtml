                        <div class="form-horizontal pccform" method="post" action="<?php echo $this->getSubmitUrl();?>">
                            <?php
                                $formHtml = str_replace(array('<captcha></captcha>','<legend></legend>'),array($captcha,''), $_form->getContactFormHtml());
                                $formHtml = preg_replace('/<legend>(.*?)<\/legend>/','',$formHtml);
                                $formHtml = str_replace('col-lg-6 visualcaptcha', 'col-lg-8 visualcaptcha', $formHtml);
                                echo $formHtml;
                            ?>
                            <input id="customer_logged_in" type="hidden" value="<?php echo $this->isCustomerLoggedIn() ? 'Yes' : 'No'; ?>">
                        </div>
                        <?php if ($isPanel) { ?>
                    </div>
                <?php } ?>
                </div>
                <div class="dependent_fields" style="display:none">
                    <?php echo $_form->getDependentFields(); ?>
                </div>
            </div>
    <?php if($inWindow){ ?>
        </div></script>
        <?php }?>

    <script type="text/javascript">
        PCCForms = true;
        <?php if($_form->getTheme()){ ?>
            PCCFThemes.push('<?php echo $_form->getTheme();?>');
        <?php } ?>
        PCCBaseJSURL = "<?php echo $jsUrl; ?>";
        RECAPTCHA_PUBLIC_KEY = '<?php echo Mage::getStoreConfig('plugincompany_contactforms/form/recaptcha_key');?>';
        PCCFileUploadUrl =  '<?php echo $this->getUploadUrl(); ?>';
        PCCFVisualCaptchaUrl =  '<?php echo $this->getVisualCaptchaUrl(); ?>';
        <?php if($_form->hasVisualCaptcha()) { ?>
            PCCFHasVisualCaptcha = true;
        <?php } ?>
        <?php if($_form->hasReCaptcha()) { ?>
            PCCFHasReCaptcha = true;
        <?php } ?>
        PCCFCloseButtonText = "<?php echo htmlentities(Mage::helper("plugincompany_contactforms")->__("close")); ?>";
        <?php if($inWindow){ ?>
            PCCFLightbox = true;
        <?php } ?>
        <?php if(stristr($_form->getContactFormHtml(),' date ')){ ?>
            PCCFDate = true;
        <?php } ?>
        <?php if($_form->getDependentFields() && $_form->getDependentFields() != "[]"){ ?>
            PCCFDependentFields.push(<?php echo $_form->getId(); ?>);
        <?php } ?>
        window.PCCF<?php echo $_form->getId(); ?>SubmitJS = function(){
            <?php echo $_form->getArbitraryJs(); ?>
        }
        window.PCCF<?php echo $_form->getId(); ?>BeforeSubmitJS = function(){
            <?php echo $_form->getBeforesubmitJs(); ?>
        }
        window.PCCFOnLoadJS[<?php echo $_form->getId(); ?>] = function(){
            <?php echo $_form->getPageloadJs(); ?>
        }
    </script>

